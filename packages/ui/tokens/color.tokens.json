{
  "color": {
    "$description": "의미 색(라이트). shadcn/ui 이름을 쓴다. Tailwind 색 이름으로 내보내 bg-primary, text-muted-foreground 같은 클래스가 된다. 값은 모두 팔레트(palette)를 가리키는 별칭이다. 다크에서 달라지는 값은 color.dark.tokens.json에 있다.",
    "background": { "$type": "color", "$value": "{palette.white}" },
    "foreground": { "$type": "color", "$value": "{palette.gray.950}" },
    "card": { "$type": "color", "$value": "{palette.white}" },
    "card-foreground": { "$type": "color", "$value": "{palette.gray.950}" },
    "popover": { "$type": "color", "$value": "{palette.white}" },
    "popover-foreground": { "$type": "color", "$value": "{palette.gray.950}" },
    "primary": { "$type": "color", "$value": "{palette.gray.900}" },
    "primary-foreground": { "$type": "color", "$value": "{palette.gray.50}" },
    "secondary": { "$type": "color", "$value": "{palette.gray.100}" },
    "secondary-foreground": { "$type": "color", "$value": "{palette.gray.900}" },
    "muted": { "$type": "color", "$value": "{palette.gray.100}" },
    "muted-foreground": {
      "$type": "color",
      "$value": "{palette.gray.550}",
      "$description": "muted 배경 위에서 WCAG AA(4.5:1)를 넘기려고 gray.500 대신 gray.550을 가리킨다. 값을 정한 근거는 palette.gray.550의 설명에 있다."
    },
    "accent": { "$type": "color", "$value": "{palette.gray.100}" },
    "accent-foreground": { "$type": "color", "$value": "{palette.gray.900}" },
    "destructive": { "$type": "color", "$value": "{palette.red.600}" },
    "destructive-foreground": { "$type": "color", "$value": "{palette.white}" },
    "scrim": {
      "$type": "color",
      "$value": "{palette.black}",
      "$description": "딤(scrim) 오버레이 전용. 모드와 무관해 다크에서 다시 정하지 않는다. 쓰는 곳은 투명도 수식자를 붙여 쓴다(docs/DECISIONS.md 2026-09-13)."
    },
    "scrim-foreground": {
      "$type": "color",
      "$value": "{palette.white}",
      "$description": "딤 위의 글자색. destructive-foreground와 값은 같은 흰색이지만 역할이 다른(딤 위 글자, 버튼 위 글자) 별도 토큰이다."
    },
    "info": { "$type": "color", "$value": "{palette.blue.600}" },
    "info-foreground": { "$type": "color", "$value": "{palette.white}" },
    "warning": { "$type": "color", "$value": "{palette.yellow.500}" },
    "warning-foreground": { "$type": "color", "$value": "{palette.gray.950}" },
    "success": { "$type": "color", "$value": "{palette.green.700}" },
    "success-foreground": { "$type": "color", "$value": "{palette.white}" },
    "border": { "$type": "color", "$value": "{palette.gray.200}" },
    "input": { "$type": "color", "$value": "{palette.gray.200}" },
    "ring": { "$type": "color", "$value": "{palette.gray.400}" }
  }
}
