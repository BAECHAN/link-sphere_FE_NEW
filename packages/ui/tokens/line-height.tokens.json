    "t1": { "$type": "dimension", "$value": { "value": 0.9375, "unit": "rem" } },
    "t2": { "$type": "dimension", "$value": { "value": 1, "unit": "rem" } },
    "t3": { "$type": "dimension", "$value": { "value": 1.125, "unit": "rem" } },
