    "t6": { "$type": "dimension", "$value": { "value": 1.5, "unit": "rem" } },
    "t7": { "$type": "dimension", "$value": { "value": 1.6875, "unit": "rem" } },
    "t8": { "$type": "dimension", "$value": { "value": 1.875, "unit": "rem" } },
    "t9": { "$type": "dimension", "$value": { "value": 2, "unit": "rem" } },
    "t10": { "$type": "dimension", "$value": { "value": 2.1875, "unit": "rem" } },
    "t11": { "$type": "dimension", "$value": { "value": 2.375, "unit": "rem" } },
    "t12": { "$type": "dimension", "$value": { "value": 2.625, "unit": "rem" } },
