{
  "shadcn": {
    "$description": "옛 shadcn/ui 색 이름. 앱과 공용 UI 부품이 아직 이 이름을 써서 의미 색(color)의 별칭으로 남긴다. CSS 변수도 예전 그대로 접두사 없이 --background처럼 나간다. 어느 의미 색을 가리킬지는 이름 꼴로 정했다: 꼬리가 없으면 배경(bg), -foreground면 글자(fg), border·input·ring은 선(stroke). 쓰는 곳을 새 이름으로 옮긴 층부터 린트로 막는다(앱은 PR 7 끝, 공용 UI 부품은 5단계 끝, 2026-11-27 게이트 3).",
    "background": { "$type": "color", "$value": "{color.bg.layer-basement}" },
    "foreground": { "$type": "color", "$value": "{color.fg.neutral}" },
    "card": { "$type": "color", "$value": "{color.bg.layer-default}" },
    "card-foreground": { "$type": "color", "$value": "{color.fg.neutral}" },
    "popover": { "$type": "color", "$value": "{color.bg.layer-floating}" },
    "popover-foreground": { "$type": "color", "$value": "{color.fg.neutral}" },
    "primary": { "$type": "color", "$value": "{color.bg.brand-solid}" },
    "primary-foreground": { "$type": "color", "$value": "{color.fg.on-brand-solid}" },
    "secondary": { "$type": "color", "$value": "{color.bg.neutral-weak}" },
    "secondary-foreground": {
      "$type": "color",
      "$value": "{palette.gray.900}",
      "$description": "라이트가 gray.900이라 fg.neutral(gray.950)과 값이 달라 팔레트를 그대로 가리킨다. fg.neutral로 합칠지는 앱의 쓰는 곳을 옮기는 PR 7에서 정한다."
    },
    "muted": { "$type": "color", "$value": "{color.bg.neutral-muted}" },
    "muted-foreground": { "$type": "color", "$value": "{color.fg.neutral-muted}" },
    "accent": { "$type": "color", "$value": "{color.bg.transparent-pressed}" },
    "accent-foreground": {
      "$type": "color",
      "$value": "{palette.gray.900}",
      "$description": "라이트가 gray.900이라 fg.neutral(gray.950)과 값이 달라 팔레트를 그대로 가리킨다. fg.neutral로 합칠지는 앱의 쓰는 곳을 옮기는 PR 7에서 정한다."
    },
    "destructive": { "$type": "color", "$value": "{color.bg.critical-solid}" },
    "destructive-foreground": { "$type": "color", "$value": "{color.fg.on-critical-solid}" },
    "scrim": { "$type": "color", "$value": "{color.bg.overlay}" },
    "scrim-foreground": { "$type": "color", "$value": "{color.fg.on-overlay}" },
    "info": { "$type": "color", "$value": "{color.bg.informative-solid}" },
    "info-foreground": { "$type": "color", "$value": "{color.fg.on-informative-solid}" },
    "warning": { "$type": "color", "$value": "{color.bg.warning-solid}" },
    "warning-foreground": { "$type": "color", "$value": "{color.fg.on-warning-solid}" },
    "success": { "$type": "color", "$value": "{color.bg.positive-solid}" },
    "success-foreground": { "$type": "color", "$value": "{color.fg.on-positive-solid}" },
    "border": { "$type": "color", "$value": "{color.stroke.neutral-weak}" },
    "input": {
      "$type": "color",
      "$value": "{palette.gray.200}",
      "$description": "다크가 white-alpha.15라 stroke.neutral-weak(10%)와 값이 달라 팔레트를 그대로 가리킨다. 합칠지는 입력칸 부품을 옮기는 5단계에서 정한다."
    },
    "ring": { "$type": "color", "$value": "{color.stroke.focus-ring}" }
  }
}
