{
  "disableAllHooks": true,
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "allowUnsandboxedCommands": false,
    "autoAllowBashIfSandboxed": false,
    "credentials": {
      "envVars": [{ "name": "CLAUDE_CODE_MESSAGING_TOKEN", "mode": "deny" }]
    },
    "filesystem": {
      "denyRead": ["~/"],
      "allowRead": ["~/.nvm/versions/node"]
    },
    "network": {
      "allowedDomains": []
    }
  },
  "permissions": {
    "allow": ["Bash(pnpm exec vitest run *)", "Bash(pnpm exec eslint *)", "Bash(pnpm type-check)"],
    "deny": ["WebFetch", "WebSearch", "Agent", "Bash(git *)", "Bash(gh *)"]
  }
}
