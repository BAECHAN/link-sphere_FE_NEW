{
  "name": "link-sphere-fe",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.20.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite --mode localhost",
    "build": "tsc -b && vite build && node scripts/inject-csp.js",
    "build:dev": "pnpm build --mode development",
    "build:prod": "pnpm build --mode production",
    "preview": "vite preview",
    "start": "pnpm preview",
    "type-check": "tsc -b --noEmit",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm type-check && pnpm lint && pnpm format:check && pnpm check:deps",
    "check:docs": "node scripts/check-docs.js",
    "check:deps": "node scripts/check-deps.js",
    "check:cloudfront": "node scripts/check-cloudfront-drift.js",
    "check:pr-body": "node scripts/check-pr-body.js",
    "check:fix": "pnpm lint:fix && pnpm format && pnpm type-check",
    "graph": "node scripts/dep-graph.js --reaches",
    "graph:focus": "node scripts/dep-graph.js --focus",
    "graph:archi": "node scripts/dep-graph.js --archi",
    "codegen:fetch": "node scripts/fetch-openapi.js && prettier --write src/shared/api/generated/openapi.json",
    "codegen": "openapi-typescript src/shared/api/generated/openapi.json -o src/shared/api/generated/openapi.gen.ts && prettier --write src/shared/api/generated/openapi.gen.ts",
    "validate": "pnpm check:env && pnpm check",
    "check:env": "node -e \"if (!require('fs').existsSync('.env')) { console.error('⚠️ .env missing'); process.exit(1); }\"",
    "test": "vitest run --project=unit",
    "test:watch": "vitest --project=unit",
    "test:coverage": "vitest run --project=unit --coverage",
    "test:storybook": "vitest run --project=storybook",
    "test:mutation": "stryker run",
    "test:e2e": "E2E_SERVER_PORT=$(node scripts/pick-e2e-port.js) playwright test",
    "test:e2e:report": "playwright show-report",
    "perf:lh": "lhci autorun --config=lighthouserc.cjs",
    "perf:lh:auth": "lhci autorun --config=lighthouserc.auth.cjs",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "clean": "rimraf dist node_modules/.vite node_modules/.tmp",
    "prepare": "husky",
    "postinstall": "pnpm prepare"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.2",
    "@radix-ui/react-alert-dialog": "1.2.1",
    "@radix-ui/react-avatar": "^1.3.1",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tooltip": "1.4.1",
    "@tanstack/react-query": "^5.107.1",
    "@tanstack/react-virtual": "3.14.26",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "dayjs": "1.11.23",
    "firebase": "12.19.0",
    "lucide-react": "0.577.0",
    "next-themes": "0.4.6",
    "nprogress": "0.2.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-error-boundary": "^5.0.0",
    "react-hook-form": "^7.91.0",
    "react-remove-scroll": "2.7.2",
    "react-router-dom": "^6.30.6",
    "sonner": "2.0.8",
    "tailwind-merge": "^3.7.0",
    "zod": "^3.24.3",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.6.0",
    "@eslint/js": "^9.39.5",
    "@google/generative-ai": "0.24.1",
    "@lhci/cli": "0.16.0",
    "@playwright/test": "1.65.0",
    "@storybook/addon-a11y": "^10.6.6",
    "@storybook/addon-docs": "^10.6.6",
    "@storybook/addon-vitest": "^10.6.6",
    "@storybook/react-vite": "^10.6.6",
    "@stryker-mutator/core": "10.1.1",
    "@stryker-mutator/vitest-runner": "10.1.1",
    "@tailwindcss/postcss": "^4",
    "@tanstack/react-query-devtools": "^5.107.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.9",
    "@types/node": "^22.20.5",
    "@types/nprogress": "0.2.3",
    "@types/react": "^18.2.55",
    "@types/react-dom": "^18.2.19",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/browser-playwright": "^4.1.12",
    "@vitest/coverage-v8": "^4.1.12",
    "@vitest/eslint-plugin": "1.6.28",
    "baseline-browser-mapping": "2.11.35",
    "dependency-cruiser": "18.7.2",
    "dotenv": "17.4.2",
    "eslint": "^9.22.0",
    "eslint-config-prettier": "9.1.2",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-playwright": "2.12.2",
    "eslint-plugin-prettier": "5.5.7",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-unicorn": "62.0.0",
    "globals": "^15.15.0",
    "husky": "^9.1.7",
    "jsdom": "28.1.0",
    "lint-staged": "17.5.1",
    "msw": "2.15.0",
    "openapi-msw": "2.1.1",
    "openapi-typescript": "7.13.0",
    "playwright": "^1.65.0",
    "pretendard": "1.3.9",
    "prettier": "^3.9.10",
    "rollup-plugin-visualizer": "^5.12.0",
    "storybook": "^10.6.6",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^6.4.6",
    "vite-plugin-mkcert": "1.17.12",
    "vitest": "^4.1.12"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix --max-warnings 0 --no-warn-ignored",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,html,css,scss,less}": [
      "prettier --write"
    ]
  }
}
