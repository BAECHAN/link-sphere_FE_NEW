shamefully-hoist=true
strict-peer-dependencies=false

# ===== 엔진 버전 강제 =====
# package.json의 engines.node를 실제로 강제한다. 이게 없으면 engines 필드는 경고만
# 띄우고 설치는 계속 진행된다(.claude/CLAUDE.md Critical Rules "Node 24 고정" 규칙이
# pnpm install 자체를 막는다고 서술하는데, 이 옵션 없이는 그 서술이 사실이 아니었다).
engine-strict=true

# ===== 보안 설정 =====
# 설치 스크립트 자동 실행 방지 (악성코드 차단)
ignore-scripts=true

# package-lock.json 필수 생성
package-lock=true

# 보안 감사 자동 실행
audit=true
audit-level=moderate

# ===== 설치 최적화 =====
# 정확한 버전만 설치 (캐럿/틸드 무시)
save-exact=true


# ===== 성능 설정 =====
# 병렬 다운로드 수
fetch-retries=3
fetch-retry-mintimeout=10000
fetch-retry-maxtimeout=60000

# ===== 개발 편의성 =====
# 자동 package-lock.json 업데이트 방지
package-lock-only=false

# progress 표시
progress=true
