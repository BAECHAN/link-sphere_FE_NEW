# 로컬 개발용 환경 변수 예시 — `cp .env.example .env` 후 빈 값을 채운다.
# 이 파일에는 실제 키·설정값을 넣지 않는다. 비어 있는 값은 프로젝트 관리자에게 받는다.

# API 기준 주소 — context-path /api까지 포함한다(vite 프록시가 요청 경로의 /api를 떼고 넘긴다).
# 운영 BE(CloudFront 경유). Lambda Function URL을 직접 쓰면 OAC 잠금 때문에 403이다.
VITE_API_BASE_URL=https://linksphere.click/api
# 로컬 BE(bootRun, 8080)에 붙일 때:
# VITE_API_BASE_URL=http://localhost:8080/api

# Firebase (FCM 푸시 알림) — Firebase Console > 프로젝트 설정 > 일반(웹 앱) / Cloud Messaging(웹 푸시 인증서)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=
